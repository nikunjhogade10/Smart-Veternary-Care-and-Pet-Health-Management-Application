# Copy to `.env` and fill in values (`.env` is gitignored).
# Razorpay: https://dashboard.razorpay.com/app/keys — use Test mode for local dev.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Daily.co (video): https://dashboard.daily.co/developers — optional; if unset, video uses Jitsi for dev/demo
DAILY_API_KEY=
DAILY_DOMAIN=

# Optional
# GROQ_API_KEY=
